# Copy to backend/.env and fill in values (never commit .env)

# Google AI Studio / Gemini API key (backend only)
GEMINI_API_KEY=

# Supabase project URL (required for ES256/JWKS access tokens — ace-study uses asymmetric signing)
# Example: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=

# Legacy HS256 only — optional if your project still uses the JWT Secret for signing
# Project Settings → API → JWT Secret (NOT the service_role key)
SUPABASE_JWT_SECRET=

# Signs server-side quiz grading tokens (never expose to the frontend).
# Optional: if unset, the server derives a key from GEMINI_API_KEY + SUPABASE_URL,
# or uses SUPABASE_JWT_SECRET when present.
QUIZ_GRADING_SECRET=

# Optional model id (must be available to your API key)
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated browser origins (no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5502,http://localhost:5502
